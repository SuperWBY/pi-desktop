{
  "manifest_version": 3,
  "name": "Pi Desktop Chrome Bridge",
  "version": "0.1.0",
  "description": "Connects the active Chrome tab to Pi Desktop computer use.",
  "permissions": ["scripting", "tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pi Desktop Chrome Bridge"
  }
}
