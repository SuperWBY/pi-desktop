{
  "manifest_version": 3,
  "name": "Pi Desktop Chrome Bridge",
  "version": "0.1.16",
  "description": "Connects the active Chrome tab to Pi Desktop computer use.",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "alarms"
  ],
  "minimum_chrome_version": "120",
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pi Desktop Chrome Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
